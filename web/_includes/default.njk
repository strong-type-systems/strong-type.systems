<!DOCTYPE html>
<html lang="en">
  <head>
    {% include "head.njk" %}
  </head>
  <body>
    <header>
      {%- include "sts_logo.html" -%}

      <nav class="main-menu">
                    {{ collections.all
                        | eleventyNavigation
                        | eleventyNavigationToHtml({
                            activeListItemClass: "active",
                            activeKey: eleventyNavigation.key
                        })
                        | safe
                    }}
         <ul>
            <!-- endfor -->
            <li class="social_links">
              <a class="social_link social_link-codeberg" href="https://codeberg.org/strong-type-systems" rel="me" title="@strong-type-systems@codeberg.org on Codeberg">@strong-type-systems@codeberg.org
              </a>
              <a class="social_link social_link-mastodon" href="https://typo.social/@strong_type_systems" rel="me" title="@strong_type_systems@typo.social on Mastodon">@strong_type_systems@typo.social
              </a>
              <a class="social_link social_link-rss" href="/feed.xml" title="Subscribe to Newsfeed">Subscribe to Newsfeed
              </a>
            </li>
         </ul>
      </nav>
    </header>
    <main class="{{ page.class }}">
      <article>
        {{ content | safe }}
      </article>
    </main>
    <footer>
       <a href="/impressum">Impressum</a>

    </footer>
  </body>
</html>


